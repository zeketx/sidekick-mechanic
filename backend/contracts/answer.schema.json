{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer payload",
  "description": "Wire contract for a Sidekick Mechanic chat answer, shared by the backend and the app. A found answer carries text, citations, and an optional highlight. A refusal is a distinct shape for a blocked claim or a wiring manual that is not ingested. It may carry a demo highlight and never citations. general_advice is the shape when the manual does not cover the question. It carries a fixed honesty line, the safety note, one to five checks, a garage basis, and related pages, and it never carries citations. A provider error is not a manual answer.",
  "oneOf": [
    { "$ref": "#/$defs/found_answer" },
    { "$ref": "#/$defs/refusal" },
    { "$ref": "#/$defs/general_advice" },
    { "$ref": "#/$defs/provider_error" }
  ],
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "page", "snippet"],
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "snippet": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "highlight_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "highlight_polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/highlight_point" }
        }
      }
    },
    "highlight_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polygons"],
      "properties": {
        "polygons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/highlight_polygon" }
        }
      }
    },
    "highlight_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bay_photo_id", "part_id"],
      "properties": {
        "bay_photo_id": {
          "type": "string",
          "minLength": 1
        },
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "enum": ["outline", "confirm"],
          "description": "Omitted means outline. confirm is the demo-mode 'Is this it?' state. Demo-scoped; not contract v2 (#86)."
        },
        "geometry": {
          "$ref": "#/$defs/highlight_geometry",
          "description": "Optional normalized polygons (origin top-left). Demo-scoped; follows #89. Abstain omits highlight."
        },
        "demo": {
          "const": true,
          "description": "Marks scripted demo-mode geometry. Omit on the normal path."
        }
      }
    },
    "found_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "citations"],
      "properties": {
        "kind": { "const": "answer" },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        },
        "highlight": { "$ref": "#/$defs/highlight_ref" }
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "reason"],
      "properties": {
        "kind": { "const": "refusal" },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "const": "not_found_in_manual"
        },
        "highlight": { "$ref": "#/$defs/highlight_ref" }
      }
    },
    "advice_garage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": { "const": "none" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": { "const": "garage" },
            "truck": { "type": "string", "minLength": 1 },
            "engine": { "type": "string", "minLength": 1 }
          },
          "anyOf": [
            { "required": ["truck"] },
            { "required": ["engine"] }
          ]
        }
      ]
    },
    "general_advice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "honesty", "safety", "steps", "garage", "related"],
      "properties": {
        "kind": { "const": "general_advice" },
        "honesty": {
          "const": "Not in your manual. Here's what usually causes this."
        },
        "safety": {
          "const": "Safety: Let the engine cool before you touch it. Disconnect the battery when the step calls for it. Support the vehicle on stands before you work underneath."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "garage": { "$ref": "#/$defs/advice_garage" },
        "related": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        },
        "highlight": { "$ref": "#/$defs/highlight_ref" }
      }
    },
    "provider_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "reason"],
      "properties": {
        "kind": { "const": "error" },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "const": "provider_unavailable"
        }
      }
    }
  }
}
