{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bay map",
  "description": "Catalog of bay photos, parts, and region polygons. A highlight on an answer stays a {bay_photo_id, part_id} pointer. This file is what that pointer looks up.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "coordinate_space", "parts", "photos"],
  "properties": {
    "schema_version": { "const": 1 },
    "coordinate_space": { "$ref": "#/$defs/coordinate_space" },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/part" }
    },
    "photos": {
      "type": "array",
      "items": { "$ref": "#/$defs/photo" }
    }
  },
  "$defs": {
    "coordinate_space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "origin", "x_axis", "y_axis"],
      "properties": {
        "units": { "const": "normalized" },
        "origin": { "const": "top_left" },
        "x_axis": { "const": "right" },
        "y_axis": { "const": "down" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "display_name", "aliases"],
      "properties": {
        "part_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bay_photo_id", "angle_id", "image_size", "source", "license", "regions"],
      "properties": {
        "bay_photo_id": { "type": "string", "minLength": 1 },
        "angle_id": { "type": "string", "minLength": 1 },
        "image_size": { "$ref": "#/$defs/image_size" },
        "source": { "$ref": "#/$defs/source" },
        "license": { "$ref": "#/$defs/license" },
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/region" }
        }
      }
    },
    "image_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["public_prototype", "owner_observation"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reference"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "polygons", "confirmation"],
      "properties": {
        "part_id": { "type": "string", "minLength": 1 },
        "polygons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/polygon" }
        },
        "confirmation": { "$ref": "#/$defs/confirmation" }
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "confirmation": {
      "oneOf": [
        { "$ref": "#/$defs/confirmed" },
        { "$ref": "#/$defs/unconfirmed" }
      ]
    },
    "confirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "confirmed_by"],
      "properties": {
        "kind": { "const": "confirmed" },
        "confirmed_by": { "type": "string", "minLength": 1 }
      }
    },
    "unconfirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "unconfirmed" }
      }
    }
  }
}
