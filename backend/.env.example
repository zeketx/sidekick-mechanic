# Copy to backend/.env (gitignored) and fill in a real key for live calls.
# Leave SIDEKICK_LLM_API_KEY empty to use the in-process fake client.
# Load into the shell before uvicorn, for example:
#   set -a && source .env && set +a

SIDEKICK_LLM_API_KEY=
SIDEKICK_LLM_BASE_URL=https://api.openai.com/v1
SIDEKICK_LLM_MODEL=gpt-4o-mini
SIDEKICK_LLM_TIMEOUT_SECONDS=30
SIDEKICK_LLM_MAX_RETRIES=2

# Plug photo check. Leave the key or the model empty and every plug check answers unsure.
# The model is TBD. The key is a Railway secret and never goes in the repo.
SIDEKICK_VISION_API_KEY=
SIDEKICK_VISION_BASE_URL=https://openrouter.ai/api/v1
SIDEKICK_VISION_MODEL=
